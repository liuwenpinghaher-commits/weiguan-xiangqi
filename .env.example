# ============================================================================
# 围观象棋 (weiguan-xiangqi) 环境变量配置模板
# 复制为 server/.env 或在启动环境中导出；请勿提交包含真实密钥的 .env 文件
# ============================================================================

# --- 服务端监听配置 ---
HOST=127.0.0.1
PORT=3410
# SQLite 数据库路径（默认 ~/.weiguan-xiangqi/weiguan.sqlite）
# DB_PATH=./weiguan.sqlite

# --- 象棋引擎配置（可选）---
# 未设置或二进制不存在时，自动启用内置确定性 UCI 兼容引擎 (BuiltinEngine)
# 若需使用原生 Pikafish NNUE 高强度引擎，请指定可执行文件路径：
# PIKAFISH_PATH=./engine/pikafish

# --- 对话大模型与向量嵌入（可选，无 Key 时自动启用离线确定性棋友点评）---
# DASHSCOPE_API_KEY=your_dashscope_api_key_here
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=your_embedding_api_key_here

# --- 语音合成 TTS 与语音识别 ASR（可选，无 Key 时自动回退浏览器 Web Speech）---
# DASHSCOPE_TTS_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# DASHSCOPE_TTS_MODEL=qwen3-tts-flash
# ASR_MODEL=qwen3-asr-flash

# --- 前端跨域与构建配置（可选）---
# FRONTEND_ORIGINS=http://localhost:3420,http://127.0.0.1:3420
# VITE_PORT=3420
# VITE_API_BASE=http://localhost:3410
