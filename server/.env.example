# 复制为 server/.env 并填入真实值(勿提交)。

# --- 阿里百炼 DashScope(OpenAI 兼容):聊天 LLM + 嵌入 + 语音 ---
# 注意:DASHSCOPE_BASE_URL 不仅聊天要用,语义记忆的嵌入(text-embedding-v3)也要用;
#       只填 KEY 不填 BASE_URL 时,聊天可用但记忆会降级为「内存不持久」模式。
DASHSCOPE_API_KEY=在此填入你的百炼 key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
# 语音(qwen3-tts-flash)
DASHSCOPE_TTS_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_TTS_MODEL=qwen3-tts-flash

# --- 象棋引擎(有 Pikafish 二进制后再填)---
# PIKAFISH_PATH=./engine/pikafish

# --- SurrealDB 语义记忆(本机独立进程,见 package.json 的 dev:surreal)---
# 均有默认值;本机单人、仅 127.0.0.1,无鉴权语义(root/root 仅本地占位)。
# SURREAL_URL=ws://127.0.0.1:8000
# SURREAL_NS=weiguan
# SURREAL_DB=weiguan
# SURREAL_USER=root
# SURREAL_PASS=root

# --- 嵌入模型(语义记忆用)---
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIM=1024
